{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://divmora.github.io/gitlab-fleet-governor/schema.json",
  "title": "GitLabFleetGovernorPolicy",
  "description": "Schema definition for GitLab Fleet Governor declarative policy configurations",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": {
      "type": "string",
      "enum": ["v1", "1", "1.0"]
    },
    "settings": {
      "type": "object",
      "properties": {
        "dry_run": { "type": "boolean", "default": true },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 },
        "log_level": { "type": "string", "enum": ["debug", "info", "warn", "error"], "default": "info" },
        "log_format": { "type": "string", "enum": ["text", "json"], "default": "text" },
        "report_format": { "type": "string", "enum": ["table", "summary", "json", "csv", "markdown"], "default": "table" },
        "service_accounts": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Explicit usernames, emails, or user IDs to classify as service accounts / bots"
        },
        "bot_patterns": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Wildcard or substring patterns matching usernames, display names, or emails as bots"
        },
        "gitlab": {
          "type": "object",
          "properties": {
            "base_url": { "type": "string" },
            "token": { "type": "string" },
            "rate_limit_rps": { "type": "number", "minimum": 0.1, "default": 30.0 },
            "rate_limit_burst": { "type": "integer", "minimum": 1, "default": 50 },
            "max_retries": { "type": "integer", "minimum": 0, "default": 3 },
            "retry_base_delay_ms": { "type": "integer", "minimum": 1, "default": 500 }
          }
        }
      }
    },
    "targets": {
      "type": "object",
      "properties": {
        "group_selector": {
          "type": "object",
          "properties": {
            "group_ids_include": { "type": "array", "items": { "type": "integer" } },
            "group_ids_exclude": { "type": "array", "items": { "type": "integer" } },
            "group_paths_include": { "type": "array", "items": { "type": "string" } },
            "group_paths_exclude": { "type": "array", "items": { "type": "string" } },
            "recursive": { "type": "boolean", "default": true }
          }
        },
        "project_selector": {
          "type": "object",
          "properties": {
            "namespaces_include": { "type": "array", "items": { "type": "string" } },
            "namespaces_exclude": { "type": "array", "items": { "type": "string" } },
            "project_name_regex_include": { "type": "string" },
            "project_name_regex_exclude": { "type": "string" },
            "visibility": { "type": "string", "enum": ["public", "internal", "private", "any"] },
            "archived": { "type": "boolean" },
            "exclude_marked_for_deletion": { "type": "boolean" },
            "id_range": {
              "type": "object",
              "properties": {
                "min": { "type": "integer", "minimum": 1 },
                "max": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    },
    "instances": {
      "type": "array",
      "description": "GitLab instances governed in one run. Each needs its own token; unset connection fields inherit settings.gitlab.",
      "items": {
        "type": "object",
        "required": ["name", "token"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
          "base_url": { "type": "string", "default": "https://gitlab.com/api/v4" },
          "token": { "type": "string" },
          "token_type": { "type": "string", "enum": ["private_token", "oauth", "job_token"] },
          "timeout_seconds": { "type": "integer", "minimum": 0 },
          "rate_limit_rps": { "type": "number", "minimum": 0.1 },
          "rate_limit_burst": { "type": "integer", "minimum": 1 },
          "max_retries": { "type": "integer", "minimum": 0 },
          "retry_base_delay_ms": { "type": "integer", "minimum": 1 },
          "retry_max_delay_ms": { "type": "integer", "minimum": 1 },
          "policies": {
            "type": "object",
            "description": "Overrides merged over the top-level policies: mappings merge field by field, keyed lists (protected_branches, variables, webhooks, ...) merge by item key with $remove and $replace markers, other values replace, null removes."
          },
          "targets": {
              "type": "object",
              "properties": {
                "group_selector": {
                  "type": "object",
                  "properties": {
                    "group_ids_include": { "type": "array", "items": { "type": "integer" } },
                    "group_ids_exclude": { "type": "array", "items": { "type": "integer" } },
                    "group_paths_include": { "type": "array", "items": { "type": "string" } },
                    "group_paths_exclude": { "type": "array", "items": { "type": "string" } },
                    "recursive": { "type": "boolean", "default": true }
                  }
                },
                "project_selector": {
                  "type": "object",
                  "properties": {
                    "namespaces_include": { "type": "array", "items": { "type": "string" } },
                    "namespaces_exclude": { "type": "array", "items": { "type": "string" } },
                    "project_name_regex_include": { "type": "string" },
                    "project_name_regex_exclude": { "type": "string" },
                    "visibility": { "type": "string", "enum": ["public", "internal", "private", "any"] },
                    "archived": { "type": "boolean" },
                    "exclude_marked_for_deletion": { "type": "boolean" },
                    "id_range": {
                      "type": "object",
                      "properties": {
                        "min": { "type": "integer", "minimum": 1 },
                        "max": { "type": "integer", "minimum": 1 }
                      }
                    }
                  }
                }
              }
            }
        }
      }
    },
    "policies": {
      "type": "object",
      "properties": {
        "job_token_scope": {
          "type": "object",
          "description": "CI/CD job token access allowlist for each targeted project (Pro).",
          "additionalProperties": false,
          "properties": {
            "limit_access": { "type": "boolean" },
            "allowed_projects": { "type": "array", "items": { "type": "string" } },
            "allowed_groups": { "type": "array", "items": { "type": "string" } },
            "prune": { "type": "boolean" }
          }
        },
        "secret_push_protection": {
          "type": "object",
          "description": "Secret push protection for each targeted project (Pro; GitLab Ultimate).",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": { "enabled": { "type": "boolean" } }
        },
        "group_settings": {
          "type": "object",
          "description": "Group-level security and membership settings applied to every targeted group (Pro).",
          "additionalProperties": false,
          "properties": {
            "visibility": { "type": "string", "enum": ["private", "internal", "public"] },
            "require_two_factor_authentication": { "type": "boolean" },
            "two_factor_grace_period": { "type": "integer", "minimum": 0 },
            "project_creation_level": { "type": "string", "enum": ["noone", "owner", "maintainer", "developer", "administrator"] },
            "subgroup_creation_level": { "type": "string", "enum": ["owner", "maintainer"] },
            "membership_lock": { "type": "boolean" },
            "share_with_group_lock": { "type": "boolean" },
            "prevent_forking_outside_group": { "type": "boolean" },
            "request_access_enabled": { "type": "boolean" },
            "emails_enabled": { "type": "boolean" },
            "mentions_disabled": { "type": "boolean" },
            "ip_restriction_ranges": { "type": "array", "items": { "type": "string" } },
            "allowed_email_domains": { "type": "array", "items": { "type": "string" } },
            "default_branch_protection": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "allowed_to_push": { "type": "array", "items": { "type": "integer", "enum": [0, 30, 40, 60] } },
                "allowed_to_merge": { "type": "array", "items": { "type": "integer", "enum": [0, 30, 40, 60] } },
                "allow_force_push": { "type": "boolean" },
                "developer_can_initial_push": { "type": "boolean" },
                "code_owner_approval_required": { "type": "boolean" }
              }
            }
          }
        },
        "push_rules": {
          "type": "object",
          "properties": {
            "author_email_regex": { "type": "string" },
            "branch_name_regex": { "type": "string" },
            "commit_message_regex": { "type": "string" },
            "file_name_regex": { "type": "string" },
            "max_file_size": { "type": "integer", "minimum": 0 },
            "prevent_secrets": { "type": "boolean" },
            "reject_unsigned_commits": { "type": "boolean" },
            "commit_committer_check": { "type": "boolean" },
            "member_check": { "type": "boolean" },
            "deny_delete_tag": { "type": "boolean" }
          }
        },
        "protected_branches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "allow_force_push": { "type": "boolean" },
              "code_owner_approval_required": { "type": "boolean" }
            }
          }
        },
        "approval_rules": {
          "type": "object",
          "properties": {
            "settings": {
              "type": "object",
              "properties": {
                "allow_author_approval": { "type": "boolean" },
                "allow_committer_approval": { "type": "boolean" },
                "allow_overrides_to_approver_list_per_merge_request": { "type": "boolean" },
                "retain_approvals_on_push": { "type": "boolean" }
              }
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "approvals_required"],
                "properties": {
                  "name": { "type": "string" },
                  "approvals_required": { "type": "integer", "minimum": 0 },
                  "user_usernames": { "type": "array", "items": { "type": "string" } },
                  "protected_branch_names": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "project_settings": {
          "type": "object",
          "properties": {
            "default_branch": { "type": "string" },
            "squash_option": { "type": "string", "enum": ["always", "never", "default_on", "default_off"] },
            "merge_method": { "type": "string", "enum": ["merge", "rebase_merge", "ff"] },
            "only_allow_merge_if_pipeline_succeeds": { "type": "boolean" },
            "only_allow_merge_if_all_discussions_are_resolved": { "type": "boolean" },
            "keep_latest_artifact": { "type": "boolean" },
            "printing_merge_request_link_enabled": { "type": "boolean" },
            "visibility": { "type": "string", "enum": ["private", "internal", "public"] },
            "public_jobs": { "type": "boolean" },
            "request_access_enabled": { "type": "boolean" },
            "forking_access_level": { "type": "string", "enum": ["disabled", "private", "enabled"] },
            "ci_forward_deployment_enabled": { "type": "boolean" },
            "ci_push_repository_for_job_token_allowed": { "type": "boolean" },
            "ci_pipeline_variables_minimum_override_role": { "type": "string", "enum": ["no_one_allowed", "developer", "maintainer", "owner"] },
            "ci_restrict_pipeline_cancellation_role": { "type": "string", "enum": ["developer", "maintainer", "no_one"] }
          }
        },
        "target_branch_rules": {
          "type": "object",
          "properties": {
            "prune_unmanaged": { "type": "boolean" },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["source_branch_pattern", "target_branch_name"],
                "properties": {
                  "source_branch_pattern": { "type": "string" },
                  "target_branch_name": { "type": "string" }
                }
              }
            }
          }
        },
        "pipeline_retention": {
          "type": "object",
          "required": ["retention_days"],
          "properties": {
            "retention_days": { "type": "integer", "minimum": 1, "maximum": 3650 }
          }
        },
        "compliance": {
          "type": "object",
          "required": ["framework_name"],
          "properties": {
            "framework_name": { "type": "string" },
            "prune": { "type": "boolean" }
          }
        }
      }
    }
  }
}
